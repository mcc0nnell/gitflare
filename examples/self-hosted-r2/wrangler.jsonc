{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gitflare-self-hosted-r2",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-23",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true
    }
  },
  "containers": [
    {
      "class_name": "RepoContainer",
      "image": "./Dockerfile",
      "max_instances": 20,
      "instance_type": "basic"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "REPO_CONTAINER",
        "class_name": "RepoContainer"
      }
    ]
  },
  "exports": {
    "RepoContainer": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "r2_buckets": [
    {
      "binding": "REPO_BACKUPS",
      "bucket_name": "gitflare-repo-backups"
    }
  ]
}
