{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gitflare-artifacts-ci",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-23",
  "compatibility_flags": ["nodejs_compat"],
  "artifacts": [
    {
      "binding": "ARTIFACTS",
      "namespace": "gitflare"
    }
  ],
  "containers": [
    {
      "class_name": "CiSandbox",
      "image": "./Dockerfile",
      "max_instances": 4,
      "instance_type": "standard-2"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "SANDBOX",
        "class_name": "CiSandbox"
      }
    ]
  },
  "triggers": {
    "events": [
      {
        "type": "cf.artifacts.repo.pushed",
        "filter": {
          "namespace": "gitflare"
        },
        "targets": [
          {
            "type": "workflow",
            "workflow_name": "gitflare-artifacts-ci"
          }
        ]
      }
    ]
  },
  "workflows": [
    {
      "name": "gitflare-artifacts-ci",
      "binding": "CI_WORKFLOW",
      "class_name": "CI"
    }
  ],
  "exports": {
    "CiSandbox": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "r2_buckets": [
    {
      "binding": "BACKUP_BUCKET",
      "bucket_name": "gitflare-ci-backups"
    }
  ],
  "vars": {
    "BACKUP_BUCKET_NAME": "gitflare-ci-backups"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true
    }
  }
}
