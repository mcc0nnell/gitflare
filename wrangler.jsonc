{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gitflare-api",
  "main": "src/assurance-entry.ts",
  "compatibility_date": "2026-08-23",
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    }
  },
  "vars": {
    "GITFLARE_SOURCE_PLANE_MODE": "unavailable"
  }
}
