{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gitflare-api",
  "main": "src/router.ts",
  "compatibility_date": "2026-08-23",
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    }
  },
  "secrets": {
    "required": [
      "GITFLARE_ADMIN_TOKEN",
      "GITFLARE_EVIDENCE_HMAC_KEY"
    ]
  },
  "artifacts": [
    {
      "binding": "ARTIFACTS",
      "namespace": "gitflare"
    }
  ],
  "r2_buckets": [
    {
      "binding": "EVIDENCE",
      "bucket_name": "gitflare-evidence"
    }
  ]
}
