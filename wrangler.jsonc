{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gitflare-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-23",
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    }
  },
  "artifacts": [
    {
      "binding": "ARTIFACTS",
      "namespace": "gitflare",
      "remote": true
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "FORGE_EVENTS",
        "class_name": "ForgeJournal"
      }
    ]
  },
  "exports": {
    "ForgeJournal": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
