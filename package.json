{
  "name": "gitflare",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --remote",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run test:forge && wrangler deploy --dry-run",
    "deploy": "wrangler deploy",
    "test:forge": "node --experimental-strip-types --test tests/*.test.mjs"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "wrangler": "4.145.0"
  }
}
